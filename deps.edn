{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.3"}
        org.clojure/core.memoize {:mvn/version "1.1.266"}
        ;;
        com.taoensso/timbre {:mvn/version "6.3.1"}
        ;;
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        ;;
        oberon/oberon {:git/url "https://github.com/OberonSystems/oberon-utils"
                       :git/sha "e748667c694f2dd13242c9817dbac54ca3d6944f"}}
 :aliases {:deps-1 {:extra-deps {org.postgresql/postgresql         {:mvn/version "42.2.5"}
                                 com.github.seancorfield/next.jdbc {:mvn/version "1.3.894"}}}

           :deps-2 {:extra-deps {org.postgresql/postgresql         {:mvn/version "42.7.1"}
                                 com.github.seancorfield/next.jdbc {:mvn/version "1.3.1108"}}}
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}
           :conjure {:extra-deps {nrepl/nrepl       {:mvn/version "1.0.0"}
                                  cider/cider-nrepl {:mvn/version "0.42.1"}}
                     :extra-paths ["test"]
                     :main-opts  ["--main" "nrepl.cmdline"
                                  "--middleware" "[cider.nrepl/cider-middleware]"
                                  "--interactive"]}}}
